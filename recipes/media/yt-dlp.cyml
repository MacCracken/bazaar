# yt-dlp — video downloader (youtube-dl fork)

[package]
name = "yt-dlp"
version = "2026.06.09"
description = "yt-dlp — feature-rich command-line video downloader"
license = "Unlicense"
groups = ["media", "tools"]

[source]
url = "https://github.com/yt-dlp/yt-dlp/archive/refs/tags/2026.06.09.tar.gz"
sha256 = "6add707714c1d9a960cb6f4de1dcbd9fbf857f1bc488d26b43f0701246a06f38"

[depends]
runtime = ["python", "ffmpeg"]
build = ["python", "pip"]

[build]
configure = ""
make = "python3 -m build --wheel --no-isolation"
check = ""
install = """
mkdir -p $PKG/usr/bin
pip install --root=$PKG --prefix=/usr dist/*.whl
"""
