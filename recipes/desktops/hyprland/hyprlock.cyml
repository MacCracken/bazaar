# hyprlock — screen locker for Hyprland (GPU-accelerated, configurable)

[package]
name = "hyprlock"
version = "0.9.5"
description = "hyprlock — GPU-accelerated screen locker for Hyprland"
license = "BSD-3-Clause"
groups = ["desktops", "wayland"]

[source]
url = "https://github.com/hyprwm/hyprlock/archive/refs/tags/v0.9.5.tar.gz"
sha256 = "cbc49fc5553c550131e1a15089847501de42579944814229bfa9f8ea18519f89"

[depends]
runtime = ["glibc", "wayland", "mesa", "cairo", "pango", "linux-pam", "hyprlang", "hyprutils", "sdbus-cpp"]
build = ["cmake", "ninja", "wayland"]

[build]
configure = "cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr"
make = "cmake --build build -j$(nproc)"
check = ""
install = "DESTDIR=$PKG cmake --install build"
