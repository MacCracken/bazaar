# ollama — run LLMs locally
# Note: AGNOS ships hoosh as the LLM gateway which can use Ollama as a backend.
# This recipe installs the Ollama server/CLI for direct local model management.

[package]
name = "ollama"
version = "0.30.8"
description = "Ollama — run large language models locally"
license = "MIT"
groups = ["ai", "llm"]

[source]
url = "https://github.com/ollama/ollama/archive/refs/tags/v0.30.8.tar.gz"
sha256 = "9f3531305be8c1dcb00c9ad0a794b5916246a98c56796dc8ba69108fa2196369"

[depends]
runtime = ["glibc"]
build = ["go", "cmake", "gcc"]

[build]
configure = ""
make = "go generate ./... && go build -o ollama ."
check = ""
install = """
mkdir -p $PKG/usr/bin
cp ollama $PKG/usr/bin/
"""
