# aider — AI pair programming in the terminal
# Routes through hoosh for LLM access, or direct to cloud providers.

[package]
name = "aider"
version = "0.86.2"
description = "aider — AI pair programming in your terminal"
license = "Apache-2.0"
groups = ["ai", "development"]

[source]
url = "https://github.com/paul-gauthier/aider/archive/refs/tags/v0.86.2.tar.gz"
sha256 = "1c5ccaac6778482b4f44bb8f105103e47c2b862e37fe5c092d3433344c648a24"

[depends]
runtime = ["python", "git"]
build = ["python", "pip"]

[build]
configure = ""
make = "pip wheel --no-deps ."
check = ""
install = "pip install --root=$PKG --prefix=/usr dist/*.whl"
