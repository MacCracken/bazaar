# jq — command-line JSON processor

[package]
name = "jq"
version = "1.8.1"
description = "jq — lightweight command-line JSON processor"
license = "MIT"
groups = ["tools"]

[source]
url = "https://github.com/jqlang/jq/releases/download/jq-1.8.1/jq-1.8.1.tar.gz"
sha256 = "2be64e7129cecb11d5906290eba10af694fb9e3e7f9fc208a311dc33ca837eb0"

[depends]
runtime = ["glibc", "oniguruma"]
build = ["gcc", "make", "autoconf", "automake", "libtool"]

[build]
configure = "./configure --prefix=/usr --disable-static"
make = "make -j$(nproc)"
check = ""
install = "make DESTDIR=$PKG install"
