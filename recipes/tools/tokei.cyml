# tokei — count lines of code quickly

[package]
name = "tokei"
version = "14.0.0"
description = "tokei — count lines of code quickly"
license = "MIT"
groups = ["tools", "development"]

[source]
url = "https://github.com/XAMPPRocky/tokei/archive/refs/tags/v14.0.0.tar.gz"
sha256 = "4e561dbb83ef1b46359714fc623fd45eddfb14821ece63a219470500fdd1cd26"

[depends]
runtime = ["glibc"]
build = ["rust"]

[build]
configure = ""
make = "cargo build --release"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp target/release/tokei $PKG/usr/bin/
"""
