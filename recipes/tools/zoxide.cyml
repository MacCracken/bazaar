# zoxide — smarter cd command (tracks frequently used directories)

[package]
name = "zoxide"
version = "0.9.9"
description = "zoxide — smarter cd command that learns your habits"
license = "MIT"
groups = ["tools"]

[source]
url = "https://github.com/ajeetdsouza/zoxide/archive/refs/tags/v0.9.9.tar.gz"
sha256 = "eddc76e94db58567503a3893ecac77c572f427f3a4eabdfc762f6773abf12c63"

[depends]
runtime = ["glibc"]
build = ["rust"]

[build]
configure = ""
make = "cargo build --release"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp target/release/zoxide $PKG/usr/bin/
"""
