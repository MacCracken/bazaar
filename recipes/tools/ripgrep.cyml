# ripgrep — fast recursive grep alternative

[package]
name = "ripgrep"
version = "15.1.0"
description = "ripgrep — fast line-oriented search tool (rg)"
license = "MIT"
groups = ["tools", "search"]

[source]
url = "https://github.com/BurntSushi/ripgrep/archive/refs/tags/15.1.0.tar.gz"
sha256 = "046fa01a216793b8bd2750f9d68d4ad43986eb9c0d6122600f993906012972e8"

[depends]
runtime = ["glibc"]
build = ["rust"]

[build]
configure = ""
make = "cargo build --release"
check = "cargo test"
install = """
mkdir -p $PKG/usr/bin
cp target/release/rg $PKG/usr/bin/
"""
