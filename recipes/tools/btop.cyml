# btop — resource monitor (CPU, memory, disk, network, processes)

[package]
name = "btop"
version = "1.4.7"
description = "btop — resource monitor with a TUI dashboard"
license = "Apache-2.0"
groups = ["tools", "monitoring"]

[source]
url = "https://github.com/aristocratos/btop/archive/refs/tags/v1.4.7.tar.gz"
sha256 = "933de2e4d1b2211a638be463eb6e8616891bfba73aef5d38060bd8319baeefc6"

[depends]
runtime = ["glibc"]
build = ["gcc", "make"]

[build]
configure = ""
make = "make -j$(nproc) OPTFLAGS='-O2'"
check = ""
install = "make DESTDIR=$PKG PREFIX=/usr install"
