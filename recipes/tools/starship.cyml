# starship — cross-shell prompt

[package]
name = "starship"
version = "1.25.1"
description = "Starship — minimal, blazing-fast cross-shell prompt"
license = "ISC"
groups = ["tools", "shell"]

[source]
url = "https://github.com/starship/starship/archive/refs/tags/v1.25.1.tar.gz"
sha256 = "521306b14066ee7e332d998ef5b5b6455fdc6085c52e86b6316a7cdc37bae1d8"

[depends]
runtime = ["glibc"]
build = ["rust"]

[build]
configure = ""
make = "cargo build --release"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp target/release/starship $PKG/usr/bin/
"""
