# k9s — Kubernetes TUI dashboard

[package]
name = "k9s"
version = "0.51.0"
description = "k9s — terminal UI to interact with Kubernetes clusters"
license = "Apache-2.0"
groups = ["tools", "kubernetes"]

[source]
url = "https://github.com/derailed/k9s/archive/refs/tags/v0.51.0.tar.gz"
sha256 = "e2c3851c909b87f9cfafa262e426f4a89023ca4e745cba5cab6d0153f76e7dcd"

[depends]
runtime = ["glibc"]
build = ["go"]

[build]
configure = ""
make = "make build"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp execs/k9s $PKG/usr/bin/
"""
