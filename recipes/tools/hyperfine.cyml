# hyperfine — command-line benchmarking tool

[package]
name = "hyperfine"
version = "1.20.0"
description = "hyperfine — command-line benchmarking tool"
license = "MIT"
groups = ["tools", "benchmarking"]

[source]
url = "https://github.com/sharkdp/hyperfine/archive/refs/tags/v1.20.0.tar.gz"
sha256 = "f90c3b096af568438be7da52336784635a962c9822f10f98e5ad11ae8c7f5c64"

[depends]
runtime = ["glibc"]
build = ["rust"]

[build]
configure = ""
make = "cargo build --release"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp target/release/hyperfine $PKG/usr/bin/
"""
