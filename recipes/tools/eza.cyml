# eza — modern replacement for ls (formerly exa)

[package]
name = "eza"
version = "0.23.4"
description = "eza — modern, maintained replacement for ls"
license = "MIT"
groups = ["tools"]

[source]
url = "https://github.com/eza-community/eza/archive/refs/tags/v0.23.4.tar.gz"
sha256 = "9fbcad518b8a2095206ac385329ca62d216bf9fdc652dde2d082fcb37c309635"

[depends]
runtime = ["glibc"]
build = ["rust"]

[build]
configure = ""
make = "cargo build --release"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp target/release/eza $PKG/usr/bin/
"""
