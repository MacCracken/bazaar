# htop — interactive process viewer

[package]
name = "htop"
version = "3.5.1"
description = "htop — interactive process viewer for Unix systems"
license = "GPL-2.0"
groups = ["tools", "monitoring"]

[source]
url = "https://github.com/htop-dev/htop/releases/download/3.5.1/htop-3.5.1.tar.xz"
sha256 = "526cecd62870aa8d14d2a79a35ea197e4e2b5317d275b567cee0574b2ddb2e9a"

[depends]
runtime = ["glibc", "ncurses"]
build = ["gcc", "make", "ncurses"]

[build]
configure = "./configure --prefix=/usr"
make = "make -j$(nproc)"
check = ""
install = "make DESTDIR=$PKG install"
