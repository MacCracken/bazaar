# fd — simple, fast alternative to find

[package]
name = "fd"
version = "10.4.2"
description = "fd — simple, fast, user-friendly alternative to find"
license = "MIT"
groups = ["tools", "search"]

[source]
url = "https://github.com/sharkdp/fd/archive/refs/tags/v10.4.2.tar.gz"
sha256 = "3a7e027af8c8e91c196ac259c703d78cd55c364706ddafbc66d02c326e57a456"

[depends]
runtime = ["glibc"]
build = ["rust"]

[build]
configure = ""
make = "cargo build --release"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp target/release/fd $PKG/usr/bin/
"""
