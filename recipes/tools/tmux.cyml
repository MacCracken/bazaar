# tmux — terminal multiplexer

[package]
name = "tmux"
version = "3.6b"
description = "tmux — terminal multiplexer for managing multiple sessions"
license = "ISC"
groups = ["tools"]

[source]
url = "https://github.com/tmux/tmux/releases/download/3.6b/tmux-3.6b.tar.gz"
sha256 = "390759d25fdba016887ec982b808927e637070fd7d03a8021f8ef3102b9ae3c7"

[depends]
runtime = ["glibc", "libevent", "ncurses"]
build = ["gcc", "make", "libevent", "ncurses"]

[build]
configure = "./configure --prefix=/usr"
make = "make -j$(nproc)"
check = ""
install = "make DESTDIR=$PKG install"
