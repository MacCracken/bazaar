# fzf — command-line fuzzy finder

[package]
name = "fzf"
version = "0.73.1"
description = "fzf — general-purpose command-line fuzzy finder"
license = "MIT"
groups = ["tools", "search"]

[source]
url = "https://github.com/junegunn/fzf/archive/refs/tags/v0.73.1.tar.gz"
sha256 = "ae4f49f8606a7d28498208fa1b93c5d3b890719eea97e02559e66160138b750c"

[depends]
runtime = ["glibc"]
build = ["go"]

[build]
configure = ""
make = "make"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp bin/fzf $PKG/usr/bin/
"""
