# syncthing — continuous file sync (peer-to-peer, no cloud)
# Perfect fit for AGNOS privacy model — no third-party servers.

[package]
name = "syncthing"
version = "2.1.1"
description = "Syncthing — continuous peer-to-peer file synchronization"
license = "MPL-2.0"
groups = ["tools", "sync"]

[source]
url = "https://github.com/syncthing/syncthing/archive/refs/tags/v2.1.1.tar.gz"
sha256 = "25976b972457dafbde3d0c606c1801a3acbc33603338f4f6d06bf4c2555178e4"

[depends]
runtime = ["glibc"]
build = ["go"]

[build]
configure = ""
make = "go run build.go -no-upgrade build"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp syncthing $PKG/usr/bin/
"""
