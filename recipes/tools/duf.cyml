# duf — disk usage/free utility (modern df replacement)

[package]
name = "duf"
version = "0.9.1"
description = "duf — disk usage/free utility with a better interface than df"
license = "MIT"
groups = ["tools"]

[source]
url = "https://github.com/muesli/duf/archive/refs/tags/v0.9.1.tar.gz"
sha256 = "1334d8c1a7957d0aceebe651e3af9e1c1e0c6f298f1feb39643dd0bd8ad1e955"

[depends]
runtime = ["glibc"]
build = ["go"]

[build]
configure = ""
make = "go build -o duf -ldflags='-s -w'"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp duf $PKG/usr/bin/
"""
