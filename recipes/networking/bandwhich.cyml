# bandwhich — terminal bandwidth utilization tool

[package]
name = "bandwhich"
version = "0.23.1"
description = "bandwhich — terminal bandwidth utilization tool per process/connection"
license = "MIT"
groups = ["networking", "monitoring"]

[source]
url = "https://github.com/imsnif/bandwhich/archive/refs/tags/v0.23.1.tar.gz"
sha256 = "aafb96d059cf9734da915dca4f5940c319d2e6b54e2ffb884332e9f5e820e6d7"

[depends]
runtime = ["glibc"]
build = ["rust"]

[build]
configure = ""
make = "cargo build --release"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp target/release/bandwhich $PKG/usr/bin/
"""
