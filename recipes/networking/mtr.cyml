# mtr — network diagnostic tool (traceroute + ping)

[package]
name = "mtr"
version = "0.96"
description = "mtr — network diagnostic tool combining traceroute and ping"
license = "GPL-2.0"
groups = ["networking", "diagnostics"]

[source]
url = "https://github.com/traviscross/mtr/archive/refs/tags/v0.96.tar.gz"
sha256 = "73e6aef3fb6c8b482acb5b5e2b8fa7794045c4f2420276f035ce76c5beae632d"

[depends]
runtime = ["glibc", "ncurses"]
build = ["gcc", "make", "autoconf", "automake", "ncurses"]

[build]
configure = "./bootstrap.sh && ./configure --prefix=/usr --without-gtk"
make = "make -j$(nproc)"
check = ""
install = "make DESTDIR=$PKG install"
