# Vim — the ubiquitous text editor

[package]
name = "vim"
version = "9.2.0661"
description = "Vim — the ubiquitous text editor"
license = "Vim"
groups = ["editors"]

[source]
url = "https://github.com/vim/vim/archive/refs/tags/v9.2.0661.tar.gz"
sha256 = "599248efe89b49d01881cb14e727d641a9f54a382b35d66d85beae78d4ed55c6"

[depends]
runtime = ["glibc", "ncurses"]
build = ["gcc", "make", "ncurses"]

[build]
configure = "./configure --prefix=/usr --with-features=huge --enable-multibyte --disable-gui"
make = "make -j$(nproc)"
check = ""
install = "make DESTDIR=$PKG install"
