# micro — modern terminal-based text editor (intuitive keybindings)

[package]
name = "micro"
version = "2.0.15"
description = "Micro — modern terminal text editor with intuitive keybindings"
license = "MIT"
groups = ["editors"]

[source]
url = "https://github.com/zyedidia/micro/archive/refs/tags/v2.0.15.tar.gz"
sha256 = "612c775321c268c8f9e1767505ff378bca9b9ab66f5c41b69ecb2464ecf15084"

[depends]
runtime = ["glibc"]
build = ["go"]

[build]
configure = ""
make = "make build"
check = ""
install = """
mkdir -p $PKG/usr/bin
cp micro $PKG/usr/bin/
"""
