# Bazaar — community recipe repository for AGNOS
# Recipes are .cyml files; tooling is written in Cyrius where possible.

[package]
name = "bazaar"
# Versioned in lockstep with zugot — each bazaar release is validated against
# a specific zugot tag (see [deps.zugot]), so they share the same version.
# Pulled from the VERSION file so cyrius.cyml and VERSION can never drift.
version = "${file:VERSION}"
description = "Bazaar — community recipe repository for AGNOS"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/bazaar"
language = "cyrius"
cyrius = "6.6.2"

[build]
entry = "scripts/validate_recipes.cyr"
output = "build/bazaar-validate"

[deps]
# toml parsing moved out of the cyrius stdlib into bayan at the 6.2.x pin
# (lib/toml.cyr no longer ships); the legacy toml_* names are re-exported via
# bayan's _compat aliases, so validate_recipes.cyr's toml_* calls keep working.
# bayan's own surface needs result/fnptr/tagged in scope — listed explicitly.
stdlib = ["string", "fmt", "alloc", "args", "vec", "str", "io", "syscalls", "fs", "bayan", "hashmap", "result", "fnptr", "tagged"]

# Zugot publishes dist/zugot.cyr — a generated index of every package name
# in the canonical recipe set. Bazaar's validator cross-checks every recipe
# dep against this at build time so PRs with unresolved deps fail CI.
# See docs/adr/006-zugot-as-cyrius-dep.md for the trust relationship.
# NOTE: no `path = "../zugot"` override here. A `path` that resolves makes the
# `git`/`tag` fields INERT (cbt/deps.cyr: need_clone stays 0 when the path exists),
# so a local sibling checkout would be vendored in place of the pinned tag — and
# `cyrius deps` would then rewrite cyrius.lock to the sibling's hash, with no
# commit pin recorded. Resolve from git+tag only, the same way CI does.
[deps.zugot]
git = "https://github.com/MacCracken/zugot.git"
tag = "1.0.6"
modules = ["dist/zugot.cyr"]
